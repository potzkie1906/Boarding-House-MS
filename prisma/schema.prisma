// Prisma schema: describes our database tables ("models") and how to connect.
// Docs: https://pris.ly/d/prisma-schema
//
// Phase 1 only sets up the connection. The real models (User, Room, Bed,
// Tenant, Bill, ...) are added in Phase 2.

generator client {
  // "prisma-client-js" generates plain JavaScript into node_modules/@prisma/client,
  // so we can `import { PrismaClient } from "@prisma/client"` without TypeScript.
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The connection URL is NOT written here. In Prisma 7 it lives in
  // prisma.config.mjs, which reads DATABASE_URL from the .env file.
}
