# Copy this file to a new file named ".env" and fill in your own values.
# Never commit your real .env file: it contains passwords. (.gitignore already skips it.)

# PostgreSQL connection string. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# If your password has special characters like @ : / # ?, they must be URL-encoded
# (for example @ becomes %40).
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/boarding_house"

# Optional: passwords the seed script (npm run db:seed) gives the sample accounts.
# If you leave these out, it uses admin12345 and tenant12345.
# They only apply when an account is first created. Re-seeding never changes an existing
# password; to start over with new ones, run: npm run db:reset
# SEED_ADMIN_PASSWORD="choose-an-admin-password"
# SEED_TENANT_PASSWORD="choose-a-tenant-password"
